{
  "manifest_version": 3,
  "name": "Custom Home Screen",
  "version": "1.0.0",
  "description": "A custom home screen with bookmark grid",
  "permissions": ["bookmarks"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "vite.svg",
    "48": "vite.svg",
    "128": "vite.svg"
  }
}
